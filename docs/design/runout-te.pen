            {
              "type": "frame",
              "id": "n1r4G5",
              "name": "Section · 02 why it matters",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "C4ZPDw",
                  "name": "Label",
                  "fill": "$te-muted",
                  "content": "02 why it matters",
                  "fontFamily": "$te-font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "N0lsDj",
                  "name": "About",
                  "fill": "$te-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "to browse a shelf or download, one of the two phones has to let the other in. when yours can be reached, people whose router is closed can still get your files, and you theirs. when neither can, nothing goes through. sonic asks your router to open its port on its own (upnp or nat-pmp).",
                  "lineHeight": 1.5,
                  "fontFamily": "$te-font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ktCNC",
              "name": "Section · 03 on mobile data",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "DYwP4",
                  "name": "Label",
                  "fill": "$te-muted",
                  "content": "03 on mobile data",
                  "fontFamily": "$te-font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "CvgHY",
                  "name": "About",
                  "fill": "$te-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "carriers put every phone behind their own router, so on mobile data no one can reach you, and sonic can't change that. you can still browse and download from anyone whose port is open, a phone at home with its port open included. sharing waits for wi-fi when \"share on wi-fi only\" is on.",
                  "lineHeight": 1.5,
                  "fontFamily": "$te-font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
