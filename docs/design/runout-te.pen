                "mObw5": {
                  "content": "STAY ONLINE IN THE BACKGROUND"
                },
                "D7Vij": {
                  "content": "keeps you signed in to soulseek after you leave the app, so downloads and messages keep arriving."
                },
                "J6aDyd": {
                  "content": "it uses a little battery and shows a quiet notification while it runs."
                },
                "CC3nH": {
                  "enabled": false
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
