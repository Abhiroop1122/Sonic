                          "type": "text",
                          "id": "xL7Xm",
                          "name": "Hint",
                          "fill": "$te-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "or forward it by hand: in your router's settings, send tcp port 57539 to 192.168.1.18, this phone. sonic always listens on that port. reserve the address for this phone too, so the router doesn't hand it to another device.",
                          "lineHeight": 1.5,
                          "fontFamily": "$te-font",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
