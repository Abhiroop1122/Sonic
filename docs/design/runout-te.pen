                          "name": "About",
                          "fill": "$te-body",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "others can't reach you: your router didn't open a port. turn on upnp or nat-pmp in its settings. you can still download from people whose port is open.",
                          "lineHeight": 1.5,
                          "fontFamily": "$te-font",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "mY02x",
                      "name": "Forward hint",
                      "width": "fill_container",
                      "padding": [
