                        0,
                        0,
                        20
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "nxwFr",
                          "name": "Hint",
                          "fill": "$te-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "or forward it by hand: in your router's settings, send tcp port 57539 to 192.168.1.18, this phone. sonic always listens on that port. reserve the address for this phone too, so the router doesn't hand it to another device.",
                          "lineHeight": 1.5,
                          "fontFamily": "$te-font",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "olUP8",
              "name": "Section · 02 why it matters",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "TWLZN",
                  "name": "Label",
                  "fill": "$te-muted",
                  "content": "02 why it matters",
                  "fontFamily": "$te-font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "kP83g",
                  "name": "About",
                  "fill": "$te-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "to browse a shelf or download, one of the two phones has to let the other in. when yours can be reached, people whose router is closed can still get your files, and you theirs. when neither can, nothing goes through. sonic asks your router to open its port on its own (upnp or nat-pmp).",
                  "lineHeight": 1.5,
                  "fontFamily": "$te-font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "lAaSP",
              "name": "Section · 03 on mobile data",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "hvCQ6",
                  "name": "Label",
                  "fill": "$te-muted",
                  "content": "03 on mobile data",
                  "fontFamily": "$te-font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "k0si2",
                  "name": "About",
                  "fill": "$te-body",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "carriers put every phone behind their own router, so on mobile data no one can reach you, and sonic can't change that. you can still browse and download from anyone whose port is open, a phone at home with its port open included. sharing waits for wi-fi when \"share on wi-fi only\" is on.",
                  "lineHeight": 1.5,
                  "fontFamily": "$te-font",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
