      "gap": 22,
      "padding": 33,
      "children": [
        {
          "type": "text",
          "id": "g2F8hD",
          "name": "Title",
          "fill": "$te-ink",
          "content": "HELP PANELS · OPENED BY TE HELP (?)",
          "fontFamily": "$te-font",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "VTT05",
          "name": "Row 1",
          "gap": 22,
          "children": [
            {
              "id": "mm5UV",
              "type": "ref",
              "ref": "zQnG4",
              "name": "Help · pure",
              "descendants": {
                "W1m2E": {
                  "content": "help · sound › output"
                },
                "mObw5": {
                  "content": "PURE"
                },
                "D7Vij": {
                  "content": "pure sends each file to the output untouched: no eq, no replaygain, no limiter, no warmth."
                },
                "J6aDyd": {
                  "content": "use it with a usb dac or amp that does its own shaping. the other sound settings rest while pure is on."
                },
                "CC3nH": {
                  "enabled": false
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
                }
              }
            },
            {
              "id": "igoWN",
              "type": "ref",
              "ref": "zQnG4",
              "name": "Help · hi-res output",
              "descendants": {
                "W1m2E": {
                  "content": "help · sound › output"
                },
                "mObw5": {
                  "content": "HI-RES OUTPUT"
                },
                "D7Vij": {
                  "content": "plays every file at its own sample rate, up to 24-bit / 192 khz, when the output accepts it."
                },
                "J6aDyd": {
                  "content": "when it can't, runout converts once, cleanly, and the signal section says so."
                },
                "CC3nH": {
                  "enabled": false
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
                }
              }
            },
            {
              "id": "nvWeq",
              "type": "ref",
              "ref": "zQnG4",
              "name": "Help · the signal verdict",
              "descendants": {
                "W1m2E": {
                  "content": "help · sound › signal"
                },
                "mObw5": {
                  "content": "THE SIGNAL VERDICT"
                },
                "D7Vij": {
                  "content": "one line on what reaches your ears: the track, what runout does to it, and what the output takes."
                },
                "J6aDyd": {
                  "content": "green: bit-perfect, nothing changed. amber: still lossless, but resampled or processed on the way."
                },
                "o3X6U": {
                  "content": "hold the deck's led window to see this chain from the room."
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
                }
              }
            },
            {
              "id": "gJN4l",
              "type": "ref",
              "ref": "zQnG4",
              "name": "Help · eq",
              "descendants": {
                "W1m2E": {
                  "content": "help · sound › equaliser"
                },
                "mObw5": {
                  "content": "EQ"
                },
                "D7Vij": {
                  "content": "ten bands from 31 hz to 16 khz, applied after replaygain."
                },
                "J6aDyd": {
                  "content": "pick a preset, drag a band, or import an autoeq profile. runout lowers the level a little first, so boosts never clip."
                },
                "CC3nH": {
                  "enabled": false
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
                }
              }
            },
            {
              "id": "G04zY",
              "type": "ref",
              "ref": "zQnG4",
              "name": "Help · replaygain",
              "descendants": {
                "W1m2E": {
                  "content": "help · sound › loudness"
                },
                "mObw5": {
                  "content": "REPLAYGAIN"
                },
                "D7Vij": {
                  "content": "evens out loudness, so you don't reach for the volume between records."
                },
                "J6aDyd": {
                  "content": "album keeps quiet and loud songs as the record intends. track makes every song as loud as the next."
                },
                "o3X6U": {
                  "content": "off plays each file at its mastered level."
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
                }
              }
            },
            {
              "id": "x23HC",
              "type": "ref",
              "ref": "zQnG4",
              "name": "Help · limiter",
              "descendants": {
                "W1m2E": {
                  "content": "help · sound › loudness"
                },
                "mObw5": {
                  "content": "LIMITER"
                },
                "D7Vij": {
                  "content": "catches the loudest peaks before they distort when eq or replaygain lift the level."
                },
                "J6aDyd": {
                  "content": "it only acts on those peaks; most records never touch it."
                },
                "CC3nH": {
                  "enabled": false
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
                }
              }
            }
          ]
        },
