                "J6aDyd": {
                  "content": "only that folder is shared, never the rest of your phone. sharing helps your downloads move faster."
                },
                "CC3nH": {
                  "enabled": false
                },
                "BYVdt/BAY2I": {
                  "content": "got it"
                }
              }
            },
