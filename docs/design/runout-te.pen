          "type": "text",
          "id": "a2j6hW",
          "name": "Note",
          "fill": "$te-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "SONIC 1.2 · THE DARK ROOM",
          "lineHeight": 1.45,
          "fontFamily": "$te-font",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "RBZkb",
          "name": "Note",
          "fill": "$te-body",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "neon deck: the dark room's deck by default, dark-only. OLED black, white neon edges; the studio lights are out unless flags › deck lights. renders in images/rg1-neon-*.png, from the live deck.",
          "lineHeight": 1.45,
          "fontFamily": "$te-font",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "M53lE2",
          "name": "Note",
          "fill": "$te-body",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "vinyl only: sideways with no page open, everything but the deck fades to black and the deck slides to the middle. the first tap anywhere only wakes the room (no key presses); ten quiet seconds put it out again.",
          "lineHeight": 1.45,
          "fontFamily": "$te-font",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "uqOsS",
          "name": "Note",
          "fill": "$te-body",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "SONIC. is printed top right on every deck (images/rg1-sonic-*.png for white / teal). shared record pictures carry the same wordmark.",
          "lineHeight": 1.45,
          "fontFamily": "$te-font",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "d9vCr",
          "name": "Note",
          "fill": "$te-body",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "bluetooth codec: off until turned on in settings › sound; then the output step names the codec as android reports it. the night set below mirrors every screen in the dark theme.",
          "lineHeight": 1.45,
          "fontFamily": "$te-font",
          "fontSize": 10,
          "fontWeight": "normal"
        }
      ]
    }
